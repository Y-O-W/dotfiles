#!/bin/sh
# pre-commit hook: scan the staged changes for secrets with gitleaks.
#
# Registered globally in ~/.gitconfig as a config-based hook (git >= 2.54):
#
#   [hook "scan-staged-secrets"]
#     event = pre-commit
#     command = ~/.git-hooks/scan-staged-secrets
#
# Runs in every repo (no opt-in): a secret is a secret in a public repo too, and GitHub's own
# secret scanning / push protection is not available for private repos on the Free plan
# (verified on this account: the API returns no security settings for a private repo).
#
# Exit codes: gitleaks is told to exit 2 when it finds a leak, so that is the only thing that
# blocks the commit. Any other failure (gitleaks missing, crashed, bad config) fails OPEN with a
# warning, so a broken scanner never stops all commits on a machine.
#
# Output is redacted, so a found secret is not printed into the terminal or its scrollback.
# False positive: add its fingerprint (printed by gitleaks) to the repo's `.gitleaksignore`.
# Skip once: `git commit --no-verify` (also skips the commit-msg hook).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "scan-staged-secrets: gitleaks not found, secret scan SKIPPED (brew install gitleaks)" >&2
  exit 0
fi

# --log-level warn keeps a clean commit silent; --verbose prints a finding's file, line and fingerprint.
gitleaks git --staged --redact --no-banner --no-color --log-level warn --verbose --exit-code 2
status=$?

case "$status" in
  0) exit 0 ;;
  2)
    echo "scan-staged-secrets: possible secret in the staged changes, commit blocked." >&2
    echo "Remove it and unstage the file, or add the fingerprint to .gitleaksignore if it is a false positive." >&2
    exit 1
    ;;
  *)
    echo "scan-staged-secrets: gitleaks failed (exit $status), secret scan SKIPPED" >&2
    exit 0
    ;;
esac
